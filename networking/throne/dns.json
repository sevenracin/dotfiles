{
  "servers": [
    {
      "type": "tailscale",
      "tag": "tailscale-dns",
      "endpoint": "route-0",
      "accept_default_resolvers": false,
      "accept_search_domain": true
    },
    {
      "type": "local",
      "tag": "direct-dns"
    },
    {
      "type": "https",
      "tag": "remote-dns",
      "server": "8.8.8.8",
      "path": "/dns-query",
      "detour": "proxy"
    }
  ],
  "rules": [
    {
      "preferred_by": "tailscale-dns",
      "action": "route",
      "server": "tailscale-dns"
    },
    {
      "rule_set": [
        "geosite-category-ai-!cn",
        "geosite-youtube"
      ],
      "action": "route",
      "server": "remote-dns"
    },
    {
      "domain": [
        "apple-relay.cloudflare.com",
        "apple-relay.fastly-edge.com",
        "cp4.cloudflare.com",
        "apple-relay.apple.com"
      ],
      "action": "route",
      "server": "remote-dns"
    },
    {
      "domain_suffix": [
        "assettolab.ru"
      ],
      "action": "route",
      "server": "remote-dns"
    },
    {
      "rule_set": [
        "geosite-google",
        "geosite-apple",
        "geosite-category-dev",
        "geosite-category-games",
        "geosite-category-ru"
      ],
      "action": "route",
      "server": "direct-dns"
    },
    {
      "domain_suffix": [
        "tailscale.com",
        "tailscale.net",
        ".local",
        ".ru",
        ".su",
        ".xn--p1ai",
        "funpay.com"
      ],
      "action": "route",
      "server": "direct-dns"
    }
  ],
  "final": "remote-dns"
}
