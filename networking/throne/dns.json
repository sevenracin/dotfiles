{
  "servers": [
    {
      "type": "tailscale",
      "tag": "tailscale-dns",
      "endpoint": "route-0",
      "accept_default_resolvers": false,
      "accept_search_domain": true
    },
    {
      "type": "local",
      "tag": "direct-dns"
    },
    {
      "type": "https",
      "tag": "remote-dns",
      "server": "8.8.8.8",
      "path": "/dns-query",
      "detour": "proxy"
    }
  ],
  "rules": [
    {
      "domain_suffix": [
        "ts.net"
      ],
      "action": "route",
      "server": "tailscale-dns"
    },
    {
      "preferred_by": [
        "tailscale-dns"
      ],
      "action": "route",
      "server": "tailscale-dns"
    },
    {
      "domain_suffix": [
        "tailscale.com",
        "tailscale.net",
        "tailscale.io",
        ".local",
        ".ru",
        ".su",
        ".xn--p1ai",
        "funpay.com"
      ],
      "action": "route",
      "server": "direct-dns"
    }
  ],
  "final": "remote-dns"
}
